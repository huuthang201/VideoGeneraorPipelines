# ---------------------------------------------------------------------------
# Google Drive workflow (§43)
# Only Claude Code reads these. The Video Engine never touches Drive - it only
# ever sees runtime/jobs/{id}/. Leave as-is to use the local workspace folder.
# ---------------------------------------------------------------------------
DRIVE_ROOT=./workspace/AI-Shorts

# ---------------------------------------------------------------------------
# TTS (§13) - Vietnamese narration is a hard requirement
# ---------------------------------------------------------------------------
# vieneu = VieNeu-TTS v3 Turbo, on-device, 48 kHz (production)
# edge   = Microsoft Edge TTS, needs no model download (fallback)
# mock   = silent audio for offline development, never publishable
TTS_ENGINE=vieneu

# A built-in preset, or the name of a voice cloned from TTS_REFERENCE_AUDIO.
#   npm run tts:voices     lists all 19 built-in Vietnamese voices
#
# Male + Northern + narration presets, closest to the "Adam" brief:
#   Thanh Bình   storytelling   <- default
#   Minh Đức     news, firm
#   Phạm Tuyên   natural
TTS_VOICE=Thanh Bình

# Reference clip for a CLONED voice. Leave empty to use a preset above.
# Set to assets/voices/adam_vi.wav once you have placed a 3-8s clean clip there.
# Cloning also needs the PyTorch engine:
#   ./.venv-vieneu/bin/python3 -m pip install 'vieneu[legacy]'
# If this names a file that does not exist, the job fails - it never silently
# falls back to another voice.
TTS_REFERENCE_AUDIO=

# Python 3.10-3.13 with vieneu installed. Created by: npm run setup:vieneu
VIENEU_PYTHON_BIN=./.venv-vieneu/bin/python3

# --- Edge TTS fallback only (ignored when TTS_ENGINE=vieneu) ----------------
TTS_RATE=+15%
TTS_PITCH=+25Hz
# Python 3.7+ with edge-tts. Created by: npm run setup:python
PYTHON_BIN=./.venv/bin/python3

# ---------------------------------------------------------------------------
# AI (§6) - one Claude call per video
# ---------------------------------------------------------------------------
AI_PROVIDER=claude-code
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# ---------------------------------------------------------------------------
# Video defaults (§38) - Claude may only override `style`, never these
# ---------------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_STYLE=tiktok-fast
VIDEO_TARGET_DURATION=25
VIDEO_DURATION_MIN=15
VIDEO_DURATION_MAX=35

# ---------------------------------------------------------------------------
# Features (§25, §26) - both off in V1
# ---------------------------------------------------------------------------
FEATURE_REMOVE_BACKGROUND=false
FEATURE_AI_IMAGE_GENERATION=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Google Drive workflow (§43)
# Only Claude Code reads these. The Video Engine never touches Drive - it only
# ever sees runtime/jobs/{id}/. Leave as-is to use the local workspace folder.
# ---------------------------------------------------------------------------
DRIVE_ROOT=./workspace/AI-Shorts

# ---------------------------------------------------------------------------
# TTS (§13) - Vietnamese narration is a hard requirement
# ---------------------------------------------------------------------------
TTS_PROVIDER=edge
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+5%
# Python interpreter that has edge-tts installed. Created by:
#   npm run setup:python
PYTHON_BIN=./.venv/bin/python3

# ---------------------------------------------------------------------------
# AI (§6) - one Claude call per video
# ---------------------------------------------------------------------------
AI_PROVIDER=claude-code
CLAUDE_BIN=claude
CLAUDE_MODEL=sonnet

# ---------------------------------------------------------------------------
# Video defaults (§38) - Claude may only override `style`, never these
# ---------------------------------------------------------------------------
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_STYLE=tiktok-fast
VIDEO_TARGET_DURATION=25
VIDEO_DURATION_MIN=15
VIDEO_DURATION_MAX=35

# ---------------------------------------------------------------------------
# Features (§25, §26) - both off in V1
# ---------------------------------------------------------------------------
FEATURE_REMOVE_BACKGROUND=false
FEATURE_AI_IMAGE_GENERATION=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

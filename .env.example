# Shared configuration, read by both pipelines.
#
# Layering: this file, then .env.<module>, then the real environment - each
# winning over the one before it. Anything a module needs its own value for
# lives in .env.podcast or .env.fact and is simply not repeated here.
#
# The split is not tidiness. The two modules publish to different YouTube
# channels under different OAuth clients, so their credentials, their narrator,
# their frame and their cadence must not be able to leak into each other.

# ---------------------------------------------------------------------------
# AI - one Claude call per video
# ---------------------------------------------------------------------------
AI_PROVIDER=claude-code

CLAUDE_BIN=claude

CLAUDE_MODEL=sonnet

# Python 3.7+ with edge-tts. Created by: npm run setup:python
PYTHON_BIN=./.venv/bin/python3

# Python 3.10+ with vieneu installed. Created by: npm run setup:vieneu
VIENEU_PYTHON_BIN=./.venv-vieneu/bin/python3

# Set these two only to force an exact size; otherwise VIDEO_ASPECT decides.
# VIDEO_WIDTH=1080
# VIDEO_HEIGHT=1920
VIDEO_FPS=30

# calm (daylight) | warm (amber, history) | night (dark and cool)
VIDEO_STYLE=calm

# ---------------------------------------------------------------------------
# Background music
# ---------------------------------------------------------------------------
# A filename inside assets/music/. Leave empty to use the first track there
# alphabetically; empty the folder to render with no music at all.
#
# MUSIC_VOLUME is the level in the gaps between sentences; under speech the mix
# drops to 35% of it automatically. A short is watched on a phone speaker, so
# 0.22 is about as loud as the bed can go before it eats consonants.
#
# assets/music/CREDITS.md lists what ships here and under which licence. The
# YouTube Audio Library is a good source (its tracks need no attribution), but
# it only serves downloads to a signed-in account, so those come in by hand.
MUSIC_FILE=

YOUTUBE_REDIRECT_PORT=4180

# ---------------------------------------------------------------------------
# Local web UI
# ---------------------------------------------------------------------------
# Port for `npm run ui`. Left off, it is 4000 - change it when something else
# on the machine already owns that port. Avoid 4180: that one is reserved for
# the YouTube consent redirect (YOUTUBE_REDIRECT_PORT).
UI_PORT=4100

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info

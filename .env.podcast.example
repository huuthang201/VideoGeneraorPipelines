# The podcast module: 5-10 minute English episodes, 16:9, bilingual subtitles,
# backdrops from the shared library the user uploads.
#
# Read after .env and wins over it. Run with: npm run podcast -- <command>

# ---------------------------------------------------------------------------
# Drive workflow
# Only the Claude Code layer reads this. The engine never touches Drive - it
# only ever sees runtime/jobs/{id}/. Leave as-is to use the local workspace.
# ---------------------------------------------------------------------------
DRIVE_ROOT=./workspace/podcast

# ---------------------------------------------------------------------------
# Shared backdrop library
# ---------------------------------------------------------------------------
# One flat set of full-frame photographs, uploaded once and drawn on by every
# episode. A project holds a brief, a storyboard and its output - never images
# of its own. Eight or more backdrops keeps a 5-10 minute episode from showing
# the same picture over and over.
LIBRARY_DIR=./runtime/podcast/library

# ---------------------------------------------------------------------------
# Narration - English, and mandatory: a job cannot finish without real speech
# ---------------------------------------------------------------------------
# edge = Microsoft Edge read-aloud (the only engine that speaks)
# mock = silent placeholder audio for offline development, never publishable
TTS_ENGINE=edge

# Any Edge neural voice. Hear the shortlist before choosing:
#   npm run tts:voices     list every English voice the service offers
#   npm run tts:sample     render the same sentence in each gentle candidate
#                          into runtime/voice-samples/, then play them
#
# The shortlist, with the service's own personality tags:
#   en-US-AriaNeural              News, Novel - storytelling         <- default
#   en-US-MichelleNeural          News, Novel - warmer than Aria
#   en-US-EmmaMultilingualNeural  Cheerful, Clear, Conversational
#   en-US-AvaMultilingualNeural   Expressive, Caring, Pleasant
#   en-GB-LibbyNeural             youngest-sounding British adult voice
#   en-US-AnaNeural               Cute (cartoon) - a child voice; blurs over a
#                                 long read, and was rejected for that
#
# English voices only: a non en-* voice fails the run before TTS starts.
TTS_VOICE=en-US-AriaNeural

# Delivery. -20% is the "0.8x" of an ordinary player. But the voice moves the
# pace as much as the rate does - measured on the same 600-word excerpt:
#   en-US-EmmaMultilingualNeural  -20%  ->  148 wpm   (this setting)
#   en-US-AnaNeural               -20%  ->  120 wpm
# Pitch +10Hz is the youth dial: young woman rather than presenter, without
# losing the consonants. The script's word budget is calibrated against this
# exact pair, so changing either makes episodes run long or short.
TTS_RATE=-20%

TTS_PITCH=+18Hz

# Softness. A few decibels down takes the edge off without blurring consonants.
TTS_VOLUME=-15%

MUSIC_VOLUME=0.28

# ---------------------------------------------------------------------------
# Video - Claude may only choose `style`, never these
# ---------------------------------------------------------------------------
# landscape = 1920x1080 (YouTube), portrait = 1080x1920 (vertical feed).
# The layout adapts to whichever is set; nothing else needs changing.
VIDEO_ASPECT=landscape

# Seconds. The per-project "Độ dài mong muốn" box overrides the target.
VIDEO_TARGET_DURATION=420

VIDEO_DURATION_MIN=300

VIDEO_DURATION_MAX=600

# ---------------------------------------------------------------------------
# YouTube upload (optional)
# ---------------------------------------------------------------------------
# Leave empty and the upload button stays off. To turn it on:
#   1. console.cloud.google.com -> new project -> enable "YouTube Data API v3"
#   2. Credentials -> Create OAuth client ID -> **Desktop app**
#      (If you pick "Web application" instead, you must also add
#       http://localhost:4180 under "Authorized redirect URIs" - a web client
#       only accepts redirect URIs registered in advance, which is what causes
#       Error 400: redirect_uri_mismatch.)
#   3. OAuth consent screen -> add your own Google account under "Test users"
#   4. paste the two values below, then run:
#        npx tsx src/cli/index.ts youtube-auth
#
# Note: Google forces uploads from API projects that have not passed its
# compliance audit to PRIVATE, whatever YOUTUBE_PRIVACY says. The upload still
# carries the title, description and chapters; you flip the switch in Studio.
YOUTUBE_CLIENT_ID=

YOUTUBE_CLIENT_SECRET=

# Prepended to every title; a separating space is added automatically.
# Leave empty for no prefix.
YOUTUBE_TITLE_PREFIX=[Eng + Vietsub]

YOUTUBE_PRIVACY=private

# 22 People & Blogs · 24 Entertainment · 27 Education
YOUTUBE_CATEGORY_ID=22

# Hours between scheduled publications (the "Lên lịch" option).
SCHEDULE_INTERVAL_HOURS=8

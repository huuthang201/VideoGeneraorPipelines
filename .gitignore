# deps
node_modules/
.venv/
.venv-vieneu/

# scratch output from npm run tts:test
tmp/

# secrets & local config
.env
.env.local

# runtime artifacts (jobs, cache, temp, logs)
runtime/

# render output
out/

# the Drive working area: user photos in, generated videos out.
# Nothing here is source, and the videos are tens of megabytes each.
workspace/

# per-job assets staged into the Remotion bundle at render time
public/jobs/

# media assets added manually (licensing varies) - keep dirs via .gitkeep
assets/music/*
assets/sfx/*
!assets/**/.gitkeep

# os / editor
.DS_Store
*.log

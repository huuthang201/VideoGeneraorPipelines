{
  "_comment": "FLUX.1-schnell (GGUF Q8_0) for the ComfyUI API. Placeholders %PROMPT%, %WIDTH%, %HEIGHT%, %SEED% are substituted by generate_image.py. GGUF rather than fp8: PyTorch on MPS has no Float8_e4m3fn kernels at all, so the fp8 safetensors build fails at the sampler on Apple Silicon regardless of how much memory is free. Q8_0 is near-bf16 quality at 11.8 GB and runs on MPS. Override with --workflow if your model filenames differ.",
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "11",
        0
      ],
      "text": "%PROMPT%"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "13",
        0
      ],
      "vae": [
        "10",
        0
      ]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "claude",
      "images": [
        "8",
        0
      ]
    }
  },
  "10": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "11": {
    "class_type": "DualCLIPLoaderGGUF",
    "inputs": {
      "clip_name1": "t5-v1_1-xxl-encoder-Q8_0.gguf",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "12": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-schnell-Q8_0.gguf"
    }
  },
  "13": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "12",
        0
      ],
      "positive": [
        "6",
        0
      ],
      "negative": [
        "16",
        0
      ],
      "latent_image": [
        "15",
        0
      ],
      "seed": "%SEED%",
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": "%WIDTH%",
      "height": "%HEIGHT%",
      "batch_size": 1
    }
  },
  "16": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "11",
        0
      ],
      "text": ""
    }
  }
}

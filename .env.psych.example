# Não Có Vấn Đề: 30-60 second Vietnamese psychology shorts, 9:16, one subtitle
# line, photographs found on Openverse at render time.
#
# Mechanically identical to the fact module - the same pipeline renders both.
# What has to be its own file is the half of this that is credentials: this
# channel authorises separately, and a YOUTUBE_CLIENT_ID inherited from the
# fact channel would upload these videos to that channel with nothing failing.
#
# Read after .env and wins over it. Run with: npm run psych -- <command>

# ---------------------------------------------------------------------------
# Drive workflow
# Only the Claude Code layer reads this. The engine never touches Drive - it
# only ever sees runtime/jobs/{id}/. Leave as-is to use the local workspace.
# ---------------------------------------------------------------------------
DRIVE_ROOT=./workspace/psych

# ---------------------------------------------------------------------------
# Backdrop photographs
# ---------------------------------------------------------------------------
# Nobody uploads pictures to this tool. The storyboard names two to four English
# search phrases, and the engine finds photographs for them on Openverse - the
# openly-licensed image search run by WordPress - then downloads, crops and
# credits them automatically.
#
# Only cc0, public-domain and CC BY results are used: those allow commercial use
# and modification. ShareAlike, NonCommercial and NoDerivatives are excluded in
# code, not by configuration. The photographer is drawn in the corner of every
# scene, which is what CC BY requires.
#
# STOCK_DIR is a cache, not a library: delete it and the next render fetches
# again. It is shared by every project so two videos about the sea do not
# download the same photograph twice.
STOCK_DIR=./runtime/psych/stock

# Openverse needs no API key, and this is empty on purpose. Anonymous access
# allows 20 searches a minute and 200 a day; at two to four searches a video
# that covers an hourly schedule with room to spare. Fill it in only if the
# daily limit is actually being hit - see https://api.openverse.org/v1/#tag/auth
OPENVERSE_TOKEN=

# Which Openverse providers to search. This is the single most effective quality
# control here: Wikimedia is 88 of the ~100 million images Openverse indexes, and
# for a natural-history subject most of that is museum digitisation - engravings,
# plate scans, skulls. Searching "rodent teeth" against everything returns a dire
# wolf skull; against these four it returns nothing, and the query gets widened
# instead, which is the better outcome.
#
# Widen this only if a subject genuinely is not covered by stock photography.
STOCK_SOURCES=stocksnap,rawpixel,flickr,nappy

# Searched when a scene's own phrase finds nothing usable, so a bad query costs
# a bland frame rather than a failed job. Deliberately generic.
STOCK_FALLBACK_QUERY=abstract nature background

# ---------------------------------------------------------------------------
# Narration - Vietnamese, and mandatory: a job cannot finish without real speech
# ---------------------------------------------------------------------------
# vieneu = VieNeu-TTS running locally (default). Nineteen named voices across
#          northern, central and southern accents, no network once the model is
#          on disk, and non-verbal cues you can write into the script.
# edge   = Microsoft Edge read-aloud. Fallback: no model download, and the only
#          engine that reports real per-word timings - but one male Vietnamese
#          voice, and an unofficial endpoint that periodically refuses clients.
# mock   = silent placeholder audio for offline development, never publishable
TTS_ENGINE=vieneu

# The narrator. For vieneu this is a preset NAME; `npm run tts:voices` lists all
# nineteen with accent and reading style. The names do not tell you the accent,
# so note it:
#
#   Thanh Bình    nam · miền Bắc · kể chuyện     <- default
#   Thái Sơn      nam · MIỀN NAM · kể chuyện     (same style, southern)
#   Phạm Tuyên    nam · miền Bắc · tự nhiên
#   Minh Đức      nam · miền Bắc · tin tức
#   Ngọc Linh     nữ  · miền Bắc · kể chuyện
#
# For TTS_ENGINE=edge this is a voice id instead, e.g. vi-VN-NamMinhNeural.
TTS_VOICE=Thanh Bình

# The three below are Edge-only: VieNeu takes its pace and tone from the voice
# itself, so they are ignored when TTS_ENGINE=vieneu.
TTS_RATE=+0%

TTS_PITCH=-10Hz

TTS_VOLUME=+0%

# Playback speed, applied after synthesis with ffmpeg's atempo - a time stretch,
# so the narrator speeds up without changing pitch. Works with every engine.
#
# WORDS_PER_MINUTE in src/domain/config.ts is calibrated against the configured
# voice at this speed. Change either and re-measure with `npm run tts:pace`, or
# every video comes out the wrong length.
TTS_SPEED=1.15

MUSIC_VOLUME=0.22

# ---------------------------------------------------------------------------
# Video - Claude may only choose `style`, never these
# ---------------------------------------------------------------------------
# portrait = 1080x1920 (Shorts), landscape = 1920x1080 (ordinary feed).
# A Short MUST be portrait: upload 16:9 and YouTube treats it as a normal video
# with black bars down the sides. The layout adapts to whichever is set.
VIDEO_ASPECT=portrait

# Seconds. The per-project "Độ dài mong muốn" box overrides the target.
# Sixty is the hard edge of the Shorts format, so the target sits under it: the
# script is written to a word budget, and a budget aimed at exactly sixty
# overshoots half the time.
VIDEO_TARGET_DURATION=45

VIDEO_DURATION_MIN=30

VIDEO_DURATION_MAX=60

# The channel name, used in the closing call to subscribe. Leave empty and the
# outro simply ends on the fact, with no call at all.
CHANNEL_NAME=Não Có Vấn Đề

# ---------------------------------------------------------------------------
# YouTube upload (optional)
# ---------------------------------------------------------------------------
# Leave empty and the upload button stays off. To turn it on:
#   1. console.cloud.google.com -> new project -> enable "YouTube Data API v3"
#   2. Credentials -> Create OAuth client ID -> **Desktop app**
#      (If you pick "Web application" instead, you must also add
#       http://localhost:4180 under "Authorized redirect URIs" - a web client
#       only accepts redirect URIs registered in advance, which is what causes
#       Error 400: redirect_uri_mismatch.)
#   3. OAuth consent screen -> add your own Google account under "Test users"
#   4. paste the two values below, then run:
#        npx tsx src/cli/index.ts youtube-auth
#
# Note: Google forces uploads from API projects that have not passed its
# compliance audit to PRIVATE, whatever YOUTUBE_PRIVACY says. The upload still
# carries the title, description and tags; you flip the switch in Studio.
#
# Nothing here says "Short". YouTube decides that from the 9:16 frame and the
# under-sixty-second length, which is why VIDEO_ASPECT and the duration
# settings below are the ones that actually matter for it.
YOUTUBE_CLIENT_ID=

YOUTUBE_CLIENT_SECRET=

# Prepended to every title; a separating space is added automatically.
# Empty by default: a Short's title is shown in a cramped two-line overlay, so
# a prefix spends characters the hook needs.
YOUTUBE_TITLE_PREFIX=

YOUTUBE_PRIVACY=private

# 27 Education · 24 Entertainment · 22 People & Blogs
YOUTUBE_CATEGORY_ID=27

# Hours between scheduled publications - the queue behind "Lên lịch" and behind
# `youtube-upload-all`. Two hours is twelve videos a day.
SCHEDULE_INTERVAL_HOURS=2

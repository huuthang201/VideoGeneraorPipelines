{
  "name": "short-video-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Auto short video generator: product image folder -> 1080x1920 MP4 with Vietnamese narration",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "bin": {
    "video-maker": "./src/cli/index.ts"
  },
  "scripts": {
    "studio": "remotion studio src/remotion/index.ts",
    "render:sample": "remotion render src/remotion/index.ts ShortVideo out/sample.mp4 --props=tests/fixtures/timeline.sample.json",
    "video-maker": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:python": "bash scripts/setup-python.sh",
    "prepare:project": "tsx src/cli/index.ts prepare",
    "generate": "tsx src/cli/index.ts generate",
    "generate-all": "tsx src/cli/index.ts generate-all",
    "render": "tsx src/cli/index.ts render",
    "regenerate": "tsx src/cli/index.ts regenerate-content",
    "check": "tsx src/cli/index.ts validate",
    "setup:vieneu": "bash scripts/setup-vieneu.sh",
    "tts:test": "./.venv-vieneu/bin/python3 scripts/test_tts.py",
    "tts:voices": "./.venv-vieneu/bin/python3 scripts/test_tts.py --list",
    "tts:compare": "./.venv-vieneu/bin/python3 scripts/compare_voices.py"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.512",
    "@remotion/captions": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/fonts": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.512",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

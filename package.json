{
  "name": "video-generator-pipelines",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Two video pipelines in one engine: English podcast episodes and Vietnamese fact shorts",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "bin": {
    "video-engine": "./src/cli/index.ts"
  },
  "scripts": {
    "podcast": "tsx src/cli/index.ts --module podcast",
    "fact": "tsx src/cli/index.ts --module fact",
    "ui": "tsx server/index.ts",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ui/tsconfig.json",
    "setup:python": "bash scripts/setup-python.sh",
    "setup:vieneu": "bash scripts/setup-vieneu.sh",
    "tts:voices:podcast": "./.venv/bin/python3 scripts/sample_voices.py --list",
    "tts:sample:podcast": "./.venv/bin/python3 scripts/sample_voices.py",
    "tts:voices:fact": "./.venv-vieneu/bin/python3 scripts/vieneu_synth.py --list-voices",
    "tts:sample:fact": "tsx scripts/sample-voices.ts",
    "tts:pace": "tsx scripts/measure-pace.ts",
    "studio": "remotion studio src/remotion/index.ts",
    "render:sample": "remotion render src/remotion/index.ts ShortVideo out/sample.mp4 --props=src/remotion/sample-timeline.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remotion/bundler": "4.0.512",
    "@remotion/captions": "4.0.512",
    "@remotion/cli": "4.0.512",
    "@remotion/fonts": "4.0.512",
    "@remotion/renderer": "4.0.512",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^1.34.0",
    "multer": "^2.2.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "4.0.512",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
